# ===== 后端环境变量示例 =====
# 复制为 .env 并填入你的密钥。后端无 Vite 代理，bailian/ark/seedream 必须填完整 BASE_URL。

# --- 省钱总开关（本地开发强烈建议开启）---
# MOCK_AI=1 时，文本 / 图像 / 视觉三个角色全部走本地假数据，零真实大模型调用、零费用。
# 开启后下面的 *_PROVIDER 与所有 API Key 都会被忽略，一个都不用配。
# 要接真实模型时，删掉这一行或改成 MOCK_AI=0。
MOCK_AI=1

# --- 数据目录（可选，默认 backend/data）---
# BOOKAGENT_DATA_DIR=./data

# --- Gemini（默认全角色）---
GEMINI_API_KEY=your_gemini_key
# 可选覆盖模型名：
# GEMINI_TEXT_MODEL=gemini-3-pro-preview
# GEMINI_VISION_MODEL=gemini-3-pro-preview
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# --- 角色分派（可选，默认全 gemini）---
# 可选值：gemini / qwen / bailian / seedream（仅 IMAGE）/ ark / mock
#   mock = 该角色走本地假数据、零真实调用；三行都写 mock 等价于 MOCK_AI=1
#   seedream 只支持 IMAGE，被配到 TEXT / VISION 时会自动回退 gemini 并告警
# TEXT_PROVIDER=gemini
# IMAGE_PROVIDER=gemini
# VISION_PROVIDER=gemini

# --- 阿里百炼 / 通义（可选，全角色：qwen + 万相）---
# BAILIAN_API_KEY=your_bailian_key
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com
# BAILIAN_TEXT_MODEL_NAME=qwen-plus
# BAILIAN_VISION_MODEL_NAME=qwen-vl-plus
# BAILIAN_IMAGE_MODEL_NAME=wan2.7-image

# --- 火山方舟 Ark（可选，全角色：豆包 + Seedream）---
# ARK_API_KEY=your_ark_key
# ARK_BASE_URL=https://ark.cn-beijing.volcesengine.com
# ARK_TEXT_MODEL_NAME=doubao-seed-1.8
# ARK_VISION_MODEL_NAME=doubao-1.5-vision-pro
# ARK_IMAGE_MODEL_NAME=seedream-5.0-pro

# --- 火山 Seedream（仅图像，需配合上方 TEXT/VISION 仍走 gemini 或 ark）---
# SEEDREAM_API_KEY=your_ark_key
# SEEDREAM_BASE_URL=https://ark.cn-beijing.volcesengine.com
# SEEDREAM_MODEL_NAME=seedream-5.0-pro
